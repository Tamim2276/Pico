{
  "expo": {
    "name": "pico",
    "slug": "pico",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tamim2276.pico"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff",
        "minSdkVersion": 26
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.tamim2276.pico",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Pico uses the camera to control the flashlight.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Pico uses your location to check traffic and weather for rescheduling."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Pico reads your calendar to suggest reschedules."
        }
      ],
      "expo-notifications"
    ],
    "owner": "rizwan_133",
    "extra": {
      "eas": {
        "projectId": "bc672930-8551-499e-83e0-54b5c0c89df0"
      },
      "llmProvider": "local"
    },
    "plugins": [
      "expo-status-bar",
      "react-native-litert-lm",
      [
        "./withLlamaRN.js",
        {
          "enableEntitlements": false,
          "forceCxx20": true,
          "enableOpenCLAndHexagon": true
        }
      ]
    ]
        "projectId": "f2d7686d-402a-4aa2-8a30-45313daaef6c"
      }
    }
  }
}
