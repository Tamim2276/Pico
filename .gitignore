# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# ── Dependencies ──────────────────────────────────────────────────────────
node_modules/
/node_modules_backup
.pnp
.pnp.js

# ── Expo ──────────────────────────────────────────────────────────────────
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts

# ── Native projects (generated by prebuild) ───────────────────────────────
/ios
/android
.kotlin/
*.orig.*
*.hprof

# Downloaded llama.rn JNI artifacts - the postinstall script fetches these
.tmp-llama-artifact-check/

# ── Build outputs ─────────────────────────────────────────────────────────
*.apk
*.aab
*.ipa
*.app
*.dSYM.zip

# ── Signing material and credentials - never commit ───────────────────────
*.jks
*.keystore
*.p8
*.p12
*.key
*.pem
*.mobileprovision
*.cer
credentials.json
google-services.json
GoogleService-Info.plist

# ── Secrets and environment ───────────────────────────────────────────────
# app.config.js reads NVIDIA_API_KEY, and the Telegram bot token can come
# from EXPO_PUBLIC_TELEGRAM_BOT_TOKEN, so no .env variant may be committed.
.env
.env.*
!.env.example

# ── On-device model weights (hundreds of MB each) ─────────────────────────
*.gguf
*.litertlm
*.bin
*.onnx
*.task

# ── Metro / bundler ───────────────────────────────────────────────────────
.metro-health-check*
.cache/
.turbo/

# ── Logs and debug output ─────────────────────────────────────────────────
*.log
logs/
npm-debug.*
yarn-debug.*
yarn-error.*
pnpm-debug.*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# ── Tests and coverage ────────────────────────────────────────────────────
coverage/
.nyc_output/

# ── TypeScript ────────────────────────────────────────────────────────────
*.tsbuildinfo

# ── Editors ───────────────────────────────────────────────────────────────
.idea/
*.iml
*.swp
*.swo
*~
.claude/settings.local.json

# ── Operating system ──────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── Python (user-manual build tooling) ────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/

# ── User manual ───────────────────────────────────────────────────────────
# The .pptx and .pdf stay tracked; the tooling and scratch renders do not.
docs/manual/build_manual.py
docs/manual/README.md
docs/manual/_p/
docs/manual/_preview/

# ── Stray local artifacts ─────────────────────────────────────────────────
*.patch
